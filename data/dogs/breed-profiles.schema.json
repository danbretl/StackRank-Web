{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.stackrankapp.com/schemas/dogs/breed-profiles.schema.json",
  "title": "StackRank Dogs breed profiles",
  "type": "object",
  "required": ["schemaVersion", "profileVersion", "sources", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1, "maxLength": 80 },
          "retrievedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "patternProperties": {
        "^VBO:\\d{7}$": {
          "type": "object",
          "required": ["summary", "interestingFact", "sizeBand", "typeLabel", "typeBasis", "originRegions", "editorialFamilies", "registryGroups", "sourceIds", "reviewStatus"],
          "properties": {
            "summary": { "type": "string", "minLength": 20, "maxLength": 700 },
            "interestingFact": { "type": "string", "minLength": 10, "maxLength": 360 },
            "sizeBand": { "enum": ["toy", "small", "medium", "large", "giant", "varies", "unknown"] },
            "typeLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
            "typeBasis": { "enum": ["registry", "editorial", "catalog"] },
            "originRegions": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
            "historicalRoots": { "type": "string", "maxLength": 300 },
            "editorialFamilies": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
            "registryGroups": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["scheme", "label", "sourceId"],
                "properties": {
                  "scheme": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "sourceId": { "type": "string", "minLength": 1, "maxLength": 80 }
                },
                "additionalProperties": false
              }
            },
            "popularity": {
              "type": "object",
              "required": ["geography", "year", "rank", "total", "sourceId"],
              "properties": {
                "geography": { "type": "string", "minLength": 1, "maxLength": 80 },
                "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
                "rank": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "total": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "sourceId": { "type": "string", "minLength": 1, "maxLength": 80 }
              },
              "additionalProperties": false
            },
            "sourceIds": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
            "reviewStatus": { "enum": ["generated", "source-reviewed", "editor-reviewed"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
