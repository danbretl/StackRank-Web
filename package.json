{
  "type": "module",
  "scripts": {
    "check": "node --check app.js && node --check books.js && node --check dogs.js && node --check dogs-shared.js && node --check home.js && node --check shared.js && node --check dogs-artwork-review.js && node --check lib/dogs-artwork-review.js && node --check dogs-explore.js && node --check category-switcher.js && node --check lib/dogs-explore.js",
    "check:cache": "node scripts/check-cache-versions.mjs",
    "check:functions": "deno check --no-lock supabase/functions/*/index.ts supabase/functions/_shared/*.ts",
    "test:functions": "deno test --no-lock --allow-read=supabase/functions supabase/functions/_shared/*_test.ts",
    "test:dogs:coordination": "python3 tests/dog-portrait-coordination.test.py && PYTHONDONTWRITEBYTECODE=1 python3 tests/dog-artwork-correction-coordination_test.py",
    "test": "node scripts/run-tests-with-report.mjs",
    "test:e2e": "node scripts/run-e2e-smoke.cjs",
    "test:data-safety:browser": "node scripts/test-data-safety-browser.cjs",
    "test:data-safety:staged": "DATA_SAFETY_SERVE_ROOT=dist/public node scripts/test-data-safety-browser.cjs",
    "test:e2e:staged": "node deploy/build.mjs && node scripts/run-e2e-smoke.cjs --serve-root=dist/public",
    "build:deploy": "node deploy/build.mjs",
    "check:deploy": "node deploy/build.mjs --check",
    "test:production": "node scripts/check-production.mjs",
    "validate:packs": "node scripts/validate-suggestion-packs.mjs",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "validate:dogs:catalog": "node scripts/validate-dog-catalog.mjs",
    "validate:dogs:profiles": "node scripts/validate-dog-profiles.mjs && node scripts/build-dog-profiles.mjs --check",
    "validate:dogs:generated-artwork": "node scripts/validate-generated-dog-artwork.mjs",
    "validate:dogs:artwork": "node scripts/validate-dog-artwork.mjs",
    "validate:dogs:artwork-discovery": "node scripts/build-dog-artwork-discovery-queue.mjs --check",
    "validate:dogs:packs": "node scripts/validate-dog-packs.mjs",
    "validate:dogs": "npm run validate:dogs:catalog && npm run validate:dogs:profiles && npm run validate:dogs:artwork && npm run validate:dogs:generated-artwork && npm run validate:dogs:artwork-discovery && npm run validate:dogs:packs",
    "build:dogs:catalog": "node scripts/build-dog-catalog.mjs",
    "build:dogs:profiles": "node scripts/build-dog-profiles.mjs",
    "build:dogs:generated-artwork": "node scripts/build-generated-dog-artwork.mjs",
    "build:dogs:artwork-discovery": "node scripts/build-dog-artwork-discovery-queue.mjs",
    "review:dogs:catalog": "node scripts/build-dog-catalog-review.mjs",
    "review:dogs:artwork": "node scripts/build-dog-artwork-review.mjs",
    "prepare:dogs:artwork": "node scripts/prepare-dog-artwork-batch.mjs",
    "deliver:dogs:artwork": "node scripts/deliver-dog-artwork.mjs",
    "activate:dogs:artwork": "node scripts/activate-dog-artwork-deliveries.mjs",
    "probe:dogs:production": "node scripts/probe-dogs-supabase-production.mjs",
    "verify": "npm test && npm run test:dogs:coordination && npm run test:dogs:packets && npm run check && npm run check:cache && npm run check:functions && npm run test:functions && npm run validate:packs && npm run validate:dogs && npm run validate:dogs:n && npm run check:deploy && npm run test:e2e:staged && npm run test:data-safety:staged && npm run test:security:staged",
    "author:packs": "node scripts/author-suggestion-packs.mjs",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "build:og": "node scripts/build-og-image.cjs",
    "test:dogs:packets": "PYTHONDONTWRITEBYTECODE=1 python3 tests/dog-portrait-packet.test.py && PYTHONDONTWRITEBYTECODE=1 python3 tests/dog-portrait-packet-m.test.py && PYTHONDONTWRITEBYTECODE=1 python3 tests/dog-portrait-n-safety.test.py && PYTHONDONTWRITEBYTECODE=1 python3 tests/dogs-n-isolation.test.py",
    "validate:dogs:n": "node scripts/validate-dogs-audit-release.mjs",
    "validate:dogs:n:private": "node scripts/dog-portrait-cohort.mjs --cohort=n --check",
    "test:security:database": "python3 scripts/test-security-database.py",
    "test:security:browser": "node scripts/test-security-browser.cjs",
    "test:security:staged": "SECURITY_SERVE_ROOT=dist/public node scripts/test-security-browser.cjs"
  }
}
